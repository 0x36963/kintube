{
  "openapi": "3.1.0",
  "info": {
    "title": "kintube API",
    "description": "Private media library API.",
    "license": {
      "name": ""
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/auth/email/start": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Email a sign-in link and code. Creates the account on first successful verification.",
        "operationId": "start_email_login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartEmailLogin"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StartEmailLoginResponse"
                }
              }
            }
          },
          "400": {
            "description": "`invalid_email`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "429": {
            "description": "`rate_limited`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/email/verify-code": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Sign in with the 6-digit code from the email. Sets the session cookie.",
        "operationId": "verify_email_code",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyEmailCode"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "400": {
            "description": "`incorrect_code` or `login_invalid`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "`account_disabled`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/email/verify-link": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Sign in with the token from the emailed magic link. Sets the session cookie.",
        "operationId": "verify_email_link",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyEmailLink"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "400": {
            "description": "`login_invalid`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          },
          "403": {
            "description": "`account_disabled`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "End the current session.",
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "Signed out (also when there was no session)"
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Liveness + database connectivity.",
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "Database unreachable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    },
    "/api/me": {
      "get": {
        "tags": [
          "account"
        ],
        "operationId": "me",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorBody": {
        "type": "object",
        "description": "Every error response has this shape: `{\"error\": {\"code\": \"...\", \"message\": \"...\"}}`.",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        }
      },
      "ErrorDetail": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Stable, machine-readable identifier, e.g. `unauthenticated`."
          },
          "message": {
            "type": "string",
            "description": "Human-readable explanation, safe to show to the user."
          }
        }
      },
      "Health": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "Me": {
        "type": "object",
        "description": "The signed-in user's own account.",
        "required": [
          "id",
          "email",
          "display_name",
          "role",
          "created_at"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "display_name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "type": "string",
            "description": "`user` or `admin`."
          }
        }
      },
      "StartEmailLogin": {
        "type": "object",
        "required": [
          "email"
        ],
        "properties": {
          "email": {
            "type": "string"
          }
        }
      },
      "StartEmailLoginResponse": {
        "type": "object",
        "required": [
          "login_id"
        ],
        "properties": {
          "login_id": {
            "type": "string",
            "format": "uuid",
            "description": "Pair with the emailed code in `/api/auth/email/verify-code`."
          }
        }
      },
      "VerifyEmailCode": {
        "type": "object",
        "required": [
          "login_id",
          "code"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "login_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "VerifyEmailLink": {
        "type": "object",
        "required": [
          "token"
        ],
        "properties": {
          "token": {
            "type": "string",
            "description": "The `token` from the emailed link's URL fragment."
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "auth",
      "description": "Passwordless sign-in and sessions"
    },
    {
      "name": "account",
      "description": "The signed-in user"
    },
    {
      "name": "system",
      "description": "Health and metadata"
    }
  ]
}
