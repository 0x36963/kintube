# Copy to .env for local development (`cp .env.example .env`).
APP_NAME=kintube
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://app:app@localhost:5432/app
BIND_ADDR=127.0.0.1:8787
SMTP_URL=smtp://localhost:1025
EMAIL_FROM="kintube <noreply@kintube.localhost>"
# Plain-http dev only. Production must use true (the default).
COOKIE_SECURE=false
# Behind Cloudflare in production: CLIENT_IP_HEADER=cf-connecting-ip
CLIENT_IP_HEADER=
# Production default is 20; loosened locally so parallel e2e runs don't trip it.
AUTH_RATE_LIMIT_PER_MINUTE=300
RUST_LOG=info,api=debug,app_core=debug,tower_http=debug
