# Copy to .env for local development (`cp .env.example .env`).
APP_NAME=kintube
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://app:app@localhost:5432/app
BIND_ADDR=127.0.0.1:8787
SMTP_URL=smtp://localhost:1025
EMAIL_FROM="kintube <noreply@kintube.localhost>"
# Plain-http dev only. Production must use true (the default).
COOKIE_SECURE=false
# Behind Cloudflare in production: CLIENT_IP_HEADER=cf-connecting-ip
CLIENT_IP_HEADER=
# Object storage: RustFS from infra/compose.dev.yml (Cloudflare R2 in production, region "auto").
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=kintube-media
S3_ACCESS_KEY_ID=kintube
S3_SECRET_ACCESS_KEY=kintube-dev-secret
S3_FORCE_PATH_STYLE=true
# Private media URLs. Dev: served by the API on a different origin than the app, like the
# production Cloudflare gateway on its own cookieless domain. The secret is shared with the gateway.
MEDIA_BASE_URL=http://127.0.0.1:8787/media
MEDIA_SERVE_FROM_API=true
MEDIA_TOKEN_SECRET=dev-only-media-token-secret-change-me-in-prod
UPLOAD_PART_SIZE_MIB=16
# Worker (cargo run -p worker)
WORKER_CONCURRENCY=2
# Production default is 20; loosened locally so parallel e2e runs don't trip it.
AUTH_RATE_LIMIT_PER_MINUTE=300
RUST_LOG=info,api=debug,app_core=debug,tower_http=debug
